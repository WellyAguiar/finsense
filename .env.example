# ==============================================================================
# FinSense — Variáveis de Ambiente (.env.local)
# Copie este arquivo para .env.local e preencha com suas credenciais.
# ==============================================================================

# 1. Banco de Dados PostgreSQL (Neon ou Supabase — plano gratuito)
DATABASE_URL="postgresql://usuario:senha@host:5432/finsense?sslmode=require"

# 2. Autenticação Google OAuth (Auth.js v5) — travada apenas no seu e-mail
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret"
ALLOWED_EMAIL="seu.email@gmail.com"

# 3. Google Gemini API (Google AI Studio — usando créditos do Google AI Pro)
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."
# Modelo padrão rápido e econômico para categorização, leitura de PDFs e chat:
GEMINI_MODEL="gemini-2.5-flash"

# 4. Open Finance Brasil — Meu Pluggy (meu.pluggy.ai + dashboard.pluggy.ai)
PLUGGY_CLIENT_ID="seu-pluggy-client-id"
PLUGGY_CLIENT_SECRET="seu-pluggy-client-secret"
# Opcional: IDs de conexões (Items) já conectados no Meu Pluggy separados por vírgula
# Você também pode adicioná-los diretamente pela interface em /configuracoes
PLUGGY_ITEM_IDS=""

# 5. Segurança do Cron Job na Vercel (gere um segredo aleatório forte)
CRON_SECRET="gere-um-segredo-aleatorio-forte"
